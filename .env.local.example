# Copiá este archivo como .env.local y completá los valores.
# .env.local NO se sube a git (está en .gitignore).

# Clave secreta de Django para producción. Generá una nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# 0 = producción (sin debug). En local podés dejarlo sin definir (queda 1).
DEBUG=0

# Hosts permitidos separados por coma (además de *.vercel.app).
# Ej: midominio.com,www.midominio.com
ALLOWED_HOSTS=

# Orígenes CSRF de confianza separados por coma (incluí https://).
# Ej: https://midominio.com
CSRF_TRUSTED_ORIGINS=

# Orígenes permitidos para el front (Next.js) separados por coma.
# Ej: https://mi-front.vercel.app
CORS_ALLOWED_ORIGINS=

# Cadena de conexión a Postgres (Neon). Para correr migraciones desde tu PC
# usá la URL UNPOOLED (directa) de Neon.
DATABASE_URL=

# URLs de "Catch Hook" de Zapier (Trigger > Webhooks by Zapier > Catch Hook).
# Si se deja vacía, ese evento simplemente no notifica (no rompe nada).
ZAPIER_WEBHOOK_STOCK_BAJO=
ZAPIER_WEBHOOK_PRESUPUESTO_APROBADO=

# URL de Incoming Webhook de Slack (App de Slack > Incoming Webhooks > Add
# New Webhook to Workspace). Gratis, sin depender del plan pago de Zapier.
# Si se deja vacía, no notifica (no rompe nada).
SLACK_WEBHOOK_DISENO_LISTO=
SLACK_WEBHOOK_TRABAJO_IMPRESO=
SLACK_WEBHOOK_TRABAJO_IMPRIMIENDO=
SLACK_WEBHOOK_PEDIDO_COMPLETADO=

# Integración saliente hacia 3darg-backend (ver config/api_3darg.py): al
# guardar un Producto marcado "es producto de ecommerce", sincroniza en
# bloque precio/medidas de ese tamaño de costeo hacia todos los Product de
# catálogo con el mismo cutter_size. URL base de 3darg-backend + token DRF
# de la cuenta de integración dedicada (usuario staff
# "integracion_presupuestos3d" en 3darg-backend). Vacío = apagado, no rompe
# el guardado del Producto.
API_3DARG_URL=
API_3DARG_TOKEN=
